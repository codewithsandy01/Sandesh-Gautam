rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidChatSession(data, userId) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.model is string && data.model.size() <= 64 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, userId, sessionId) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == userId &&
             data.sessionId is string && data.sessionId == sessionId &&
             data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() <= 50000 &&
             data.timestamp is number;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         isValidChatSession(incoming(), userId) &&
                         incoming().id == sessionId &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time;
        allow update: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         isValidChatSession(incoming(), userId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (incoming().updatedAt == request.time || incoming().updatedAt == existing().updatedAt);
        allow delete: if isOwner(userId) && isValidId(sessionId);

        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(sessionId) && isValidId(messageId);
          allow list: if isOwner(userId) && isValidId(sessionId);
          allow create: if isOwner(userId) &&
                           isValidId(sessionId) &&
                           isValidId(messageId) &&
                           isValidChatMessage(incoming(), userId, sessionId) &&
                           incoming().id == messageId;
          allow update: if isOwner(userId) &&
                           isValidId(sessionId) &&
                           isValidId(messageId) &&
                           isValidChatMessage(incoming(), userId, sessionId) &&
                           incoming().id == existing().id &&
                           incoming().userId == existing().userId &&
                           incoming().sessionId == existing().sessionId;
          allow delete: if isOwner(userId) && isValidId(sessionId) && isValidId(messageId);
        }
      }
    }
  }
}
