{
  "entities": {
    "ChatSession": {
      "title": "ChatSession",
      "description": "A conversation session for SandY Intelligence",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "model": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt", "model"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message item within a chat session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"]
        },
        "content": {
          "type": "string",
          "maxLength": 50000
        },
        "timestamp": {
          "type": "number"
        },
        "modelUsed": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "sessionId", "userId", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}/sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/ChatSession"
      },
      "description": "User-owned chat session metadata"
    },
    "/users/{userId}/sessions/{sessionId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Individual messages belonging to a chat session"
    }
  }
}
